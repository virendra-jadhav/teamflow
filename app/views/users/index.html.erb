<h1>Users</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>

      <% if current_membership&.admin? %>
      <th>Role</th>
      <th>Actions</th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
    <% membership = user.memberships.find_by(account: current_account) %>

    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>

      <% if current_membership&.admin? %>
      <td><%= membership.role %></td>

      <td>
        <%= button_to "Update Role",
                  update_role_user_path(user),
                  method: :patch,
                  params: { role: "admin" } %>
      </td>
      <% end %>
    </tr>
    <% end %>
  </tbody>
</table>