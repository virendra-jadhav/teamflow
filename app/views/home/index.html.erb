<h1>Welcome, <%= current_user.name %></h1>

<%
=begin%>
<p>Your role: <%= current_user.role %></p>
<%
=end%>
<% if current_account && current_membership %>
<p>
  Account: <%= current_account.name %><br>
  Your role: <%= current_membership.role %>
</p>


<% else %>
<p>No account selected.</p>
<% end %>
<p><%= link_to "Create Account", new_account_path %></p>

<p><%= link_to "Users", users_path %></p>

<nav>
  <% if current_account && current_membership && current_membership.admin? %>
  <%= link_to "Manage Users", users_path %> |
  <%= link_to "Edit Profile", edit_user_path(current_user) %>
  <% end %>

  <%= button_to "Logout", logout_path, method: :delete %>
</nav>