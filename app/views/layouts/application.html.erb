<!DOCTYPE html>
<html>

<head>
  <title><%= content_for(:title) || "Teamflow" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  
  <%= javascript_importmap_tags %>
</head>

<body>
  <%# <% flash.each do |type, message| %>
  <%# <div class="flash <%= type %>
  <%# <%= message %>
  <%# </div> %>
  <%# <% end %>
  <% if flash[:notice] %>
  <p style="color: green"><%= flash[:notice] %></p>
  <% end %>

  <% if flash[:alert] %>
  <p style="color: red"><%= flash[:alert] %></p>
  <% end %>

  <nav>
    <% if current_user %>
    Logged in as <strong><%= current_user.email %></strong> |
    <%= link_to "Users", users_path %> |
    <%= link_to "New User", new_user_path %> |
    <%= link_to "Home", home_path %> |
    <%= button_to "Logout", logout_path, method: :delete %>

    <% else %>
    <%= link_to "Login", login_path %>
    <% end %>
  </nav>

  <hr>

  <% if current_user && current_user.accounts.any? %>
  <div class="account-switcher">
    <%= form_with url: account_switch_path, method: :post, local: true do %>

    <label>Current account:</label>

    <%= select_tag :account_id,
        options_from_collection_for_select(
          current_user.accounts,
          :id,
          :name,
          current_account&.id
        ),
        prompt: "Select an account",
        required: true
      %>

    <%= submit_tag "Switch Account" %>
    <% end %>
  </div>
  <% end %>

  <% if current_membership&.admin? %>
  | <%= link_to "Account Settings", accounts_settings_path %>
  <% end %>


  <%= yield %>


</body>

</html>