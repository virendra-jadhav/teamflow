<h1>Users</h1>

<p>
  <%= link_to "Create New User", new_user_path %>
</p>

<table border="1" cellpadding="8">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td>
        <%= link_to "Edit", edit_user_path(user) %> |
        <%= button_to "Delete",
              user_path(user),
              method: :delete,
              data: { confirm: "Are you sure?" },
              form: { style: "display:inline" } %>


      </td>

    </tr>
    <% end %>
  </tbody>
</table>