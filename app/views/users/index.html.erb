<h1>Users</h1>

<% if current_membership&.admin? %>
<h2>Invite a user</h2>

<%= form_with url: invitations_path, method: :post do %>
<div>
  <%= label_tag :email, "User email" %><br>
  <%= email_field_tag :email, nil, required: true %>
</div>

<div>
  <%= label_tag :role, "Role" %><br>
  <%= select_tag :role,
            options_for_select(
              Invitation::VALID_ROLES.map { |r| [r.titleize, r] },
              "member"
            ),
            required: true %>
</div>

<%= submit_tag "Send Invitation" %>
<% end %>

<hr>
<% end %>


<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>

      <% if current_membership&.admin? %>
      <th>Role</th>
      <th>Actions</th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
    <% membership = user.memberships.find_by(account: current_account) %>

    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>

      <% if current_membership&.admin? %>
      <td><%= membership.role %></td>

      <td>
        <%= button_to "Update Role",
                  update_role_user_path(user),
                  method: :patch,
                  params: { role: "admin" } %>
      </td>
      <% end %>
    </tr>
    <% end %>
  </tbody>
</table>