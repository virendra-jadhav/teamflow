<h2>Reset Password</h2>

<%= form_with model: @user,
              url: password_reset_path(params[:token]),
              method: :patch,
              local: true do |f| %>

<div>
  <%= f.label :password %>
  <%= f.password_field :password %>
</div>

<div>
  <%= f.label :password_confirmation %>
  <%= f.password_field :password_confirmation %>
</div>

<%= f.submit "Reset password" %>
<% end %>